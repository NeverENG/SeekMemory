{
  "name": "seekmemory-dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock",
    "dev:mock": "vite --mode mock",
    "dev:host": "vite --mode host",
    "dev:standalone": "vite --mode standalone",
    "build": "tsc -b && vite build",
    "lint": "oxlint --type-aware --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.ts",
    "check": "pnpm check:api && pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "preview": "vite preview",
    "generate:api": "pnpm --filter @seekmemory/api-codegen generate",
    "check:api": "pnpm --filter @seekmemory/api-codegen check",
    "test:contract": "node --test tests/contracts/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "happy-dom": "21.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "~7.0.2",
    "vite": "^8",
    "yaml": "2.8.2"
  }
}
