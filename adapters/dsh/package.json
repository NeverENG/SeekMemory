{
  "name": "dsh-seekmemory",
  "version": "0.0.1",
  "description": "SeekMemory host adapter for DeepSeek Harness: capture → recall → persona over a loopback kernel contract.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1",
    "node": ">=22.16.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node scripts/check-manifest.mjs",
    "check:installed": "scripts/postinstall-check.cmd",
    "lint": "node scripts/check-manifest.mjs",
    "build": "node scripts/build-check.mjs",
    "postinstall:check": "node scripts/postinstall-check.mjs",
    "test": "node test/client-failopen.mjs && node test/hooks-fake-host.mjs && node test/persona-isolation.mjs && node test/safe-mode.mjs && node test/extract-bridge.mjs && node test/postinstall-check.mjs && node test/install-profile.mjs",
    "mock": "node mock/kernel.mjs --data-dir .tmp/mock",
    "smoke": "node scripts/smoke-contract.mjs --runtime .tmp/mock/runtime.json",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "seekmemory"
  ],
  "license": "MIT"
}
